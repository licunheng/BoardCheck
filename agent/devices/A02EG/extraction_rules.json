{
  "version": "1.0.0",
  "description": "A02EG 字段抽取规则(正则优先级最高,LLM 作为兜底)。与 F16G 混打日志时,仅匹配 A02EG 老格式行。",
  "extraction_priority": "regex_first_llm_fallback",
  "field_extractors": {
    "sn": {
      "regex": "发:568121440200([0-9A-Fa-f]{32})",
      "context_anchor": "发:568121440200([0-9A-Fa-f]{32})",
      "post_process": [
        "trim",
        "upper"
      ],
      "must_be_present": true,
      "notes": "SN 来自 '发:568121440200' 指令行,取 32 位 hex;尾码与授权数据不捕获。以 FA000001400001 开头。"
    },
    "mac": {
      "regex": "收mac:([0-9A-Fa-f]{12})",
      "context_anchor": "收mac:([0-9A-Fa-f]{12})",
      "post_process": [
        "trim",
        "upper"
      ],
      "must_be_present": true,
      "notes": "MAC 12 位 hex,来自 '收mac:' 行(无空格,与 F16G 的 '收 :mac:' 14 位区分)。= 追溯码后 12 位(派生关系实测)。"
    },
    "iccid": {
      "regex": "4G\\s*CCID[:：]?\\s*([0-9A-Fa-f]{19,20})",
      "context_anchor": "4G\\s*CCID[:：]?\\s*([0-9A-Fa-f]{19,20})",
      "post_process": [
        "trim",
        "upper"
      ],
      "must_be_present": true,
      "sanitize_duplicates": true,
      "notes": "ICCID 20 位数字以 8986 开头,来自 '4G CCID:' 行(注意拼写与 F16G 的 '收 :ICCID:' 不同)。"
    },
    "trace_code": {
      "regex": "回复追溯码[:：]\\s*(F069[0-9A-Z]{18})",
      "context_anchor": "回复追溯码[:：]\\s*(F069[0-9A-Z]{18})",
      "post_process": [
        "trim",
        "upper"
      ],
      "must_be_present": true,
      "authoritative_forms": [
        "回复追溯码"
      ],
      "notes": "追溯码 22 位以 F069 开头,来自 '回复追溯码:' 行(平台真值)。日志中 '发: trace code:' 是 F16G 临时追溯码,不参与。"
    }
  },
  "session_binding": {
    "description": "将同一台 A02EG 设备测试循环的关键行绑定到一条记录。同串口测试是串行的,回复追溯码前 120 秒内必有其最后一次重试循环的 SN/MAC/ICCID。",
    "method": "temporal_proximity",
    "window_seconds": 300,
    "tie_breaker": "trace_code_response_time",
    "sn_direction": "before"
  },
  "field_anchors": {
    "sn": [
      "发:568121440200([0-9A-Fa-f]{32})"
    ],
    "mac": [
      "收mac:([0-9A-Fa-f]{12})"
    ],
    "iccid": [
      "4G\\s*CCID[:：]?\\s*([0-9A-Fa-f]{19,20})"
    ],
    "trace_code": [
      "回复追溯码[:：]\\s*(F069[0-9A-Z]{18})"
    ]
  },
  "llm_fallback": {
    "enabled": true,
    "trigger_when_regex_fails": true,
    "max_lines_per_call": 500,
    "prompt_section": "extraction"
  },
  "llm_verification": {
    "enabled": false,
    "note": "复核层默认不开(推理模型会空转, 详见 docs/debugging/05);确定性校验是基线。"
  }
}
