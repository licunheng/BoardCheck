{
  "version": "1.0.0",
  "description": "A02FG 文本日志行级过滤规则。保留所有可能含 SN/MAC/ICCID/追溯码的行,剔除无关行。",

  "keep_patterns": [
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:发:.*FA000001400001",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:收mac:",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:4G\\s+CCID:",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:回复追溯码:",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:收:.*FA000001400001"
  ],

  "drop_patterns": [
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:版本:",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:品牌:",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:网关版本校验",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:批次ok",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:授权",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:成功连接",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:发送授权",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:板检启动指令",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:板检结果",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:over",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:获取授权超时",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+.*请求至服务器",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:发:568001",
    "^\\d{2}:\\d{2}:\\d{2}\\s+\\d+\\s+\\|\\s+COM\\d+:发:568202",
    "板检配置信息",
    "软件版本",
    "未获取到",
    "登录成功"
  ],

  "field_anchors": {
    "sn": [
      "FA000001400001[0-9A-F]{18}",
      ":发:568121440200(FA000001400001[0-9A-F]{18})"
    ],
    "mac": [
      "收mac:([0-9A-F]{12})",
      "([0-9A-F]{12})"
    ],
    "iccid": [
      "4G\\s+CCID:([0-9A-F]{19,20})"
    ],
    "trace_code": [
      "回复追溯码:(F070[0-9A-Z]{6}[0-9A-Z]{12})"
    ]
  },

  "lines_preserved_intact": true,
  "trim_whitespace": true
}