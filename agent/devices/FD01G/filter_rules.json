{
  "version": "1.0.0",
  "description": "FD01G 日志预处理 keep/drop 规则。保留含 SN/MAC/ICCID/追溯码的关键行,剔除流程干扰行(收原始数据 hex、success、TEMP、电压、按钮提示等)。",
  "keep_patterns": [
    "收\\s*:id\\s*:",
    "MAC\\s*:\\s*[0-9A-Fa-f]{12}",
    "4G\\s+CCID\\s*:",
    "回复网关SN\\s*:",
    "收到回复网关SN\\s*:",
    "上传SN成功",
    "流水号"
  ],
  "drop_patterns": [
    "收原始数据\\s*:",
    "收\\s*:\\s*start",
    "success",
    "ROOMTEMP",
    "设置的温度",
    "TEMP\\s*:",
    "电压",
    "voltage",
    "板检用时",
    "Excel导出成功",
    "上传板检记录成功",
    "板检启动指令",
    "收到授权",
    "转发授权",
    "发送授权请求",
    "授权成功",
    "成功连接云端",
    "批次ok",
    "运营商",
    "号段",
    "主设备",
    "从设备",
    "网关版本校验",
    "板检结果",
    "over",
    "发\\s*:",
    "温度检测",
    "互感电流",
    "请按一下按键",
    "Please press",
    "红外",
    "蓝牙",
    "KEY",
    "VALVE",
    "TX",
    "RX_UN",
    "AC_P",
    "AC_A",
    "AC_XY",
    "XF",
    "BLE",
    "5V",
    "TEMP"
  ],
  "lines_preserved_intact": true,
  "trim_whitespace": true
}